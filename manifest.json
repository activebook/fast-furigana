{
  "manifest_version": 3,
  "name": "Fast Furigana",
  "version": "1.2.0",
  "description": "Ultra-fast, lightweight Japanese furigana injector for Google Chrome.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Fast Furigana"
  },
  "commands": {
    "toggle-furigana": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Toggle Fast Furigana on or off"
    }
  },
  "permissions": [
    "offscreen",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dict/*.dat"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}